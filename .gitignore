# ===== 机密 / 凭据 =====
# 任何 LLM API key、token、个人凭据都不得进 git
.env
.env.*
!.env.example
secrets/
*.key
*.pem
.deepseek_key
.openai_key
.anthropic_key
config.local.*

# ===== 本地大文件 / 工具缓存(不进 git)=====
# CBDB SQLite / chinese-poetry 全文等大库,法律边界 + 体积考虑不进仓库
_local/
raw/cbdb/
raw/chinese-poetry/
raw/wikidata-dump/
*.7z
*.zip
*.tar.gz

# 注: raw/ 下"小型外部数据集"(JSON/TSV/Wikipedia 摘录/AI 生成元数据等)
# 通过 ADR-028 已决定**进 git**(总量 ~78 MB,在 GitHub repo 限内)
# 仅 raw/cbdb/ 等大库子目录单独 gitignore

