{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "person.schema.json",
  "title": "Person",
  "type": "object",
  "required": ["id", "name", "dynastyId"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^person_[a-z0-9_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "nameEn": { "type": ["string", "null"] },
    "birthYear": { "type": ["integer", "null"] },
    "deathYear": { "type": ["integer", "null"] },
    "yearUncertainty": { "type": "string", "enum": ["exact", "year", "decade", "century", "era"] },
    "dynastyId": { "type": "string", "pattern": "^dynasty_[a-z0-9_]+$" },
    "regimeId": { "type": ["string", "null"] },
    "role": { "type": "string" },
    "summary": { "type": ["string", "null"], "maxLength": 1000 },
    "body": { "type": ["string", "null"], "maxLength": 8000 },
    "portrait": { "type": ["string", "null"] },
    "portraitSource": { "type": ["string", "null"] },
    "portraitLicense": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "historicity": { "type": "string", "enum": ["historical", "semi-historical", "legendary"] },
    "source": { "type": "string" },
    "_schemaVersion": { "type": "string" }
  }
}
